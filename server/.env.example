PORT=9000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultzero
PG_FORCE_SSL=false

JWT_SECRET=
HMAC_SECRET=

EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Resend API configuration (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Optional override, defaults to https://api.resend.com
RESEND_API_BASE_URL=

# Gmail App Password SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FORCE_IPV4=true
# Optional static IPv4 override for SMTP host. If set, it is tried first, then resolved Gmail IPv4 records.
SMTP_HOST_IP=
# Allow automatic fallback attempts on both ports 587 (STARTTLS) and 465 (implicit TLS)
SMTP_DISABLE_ALT_PORTS=false
# Fail-fast SMTP tuning for hosts that block outbound SMTP
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000
# Open a temporary cooldown after repeated connectivity errors to avoid long API hangs
SMTP_FAIL_THRESHOLD=2
SMTP_BLOCK_COOLDOWN_MS=600000

# Render/Gmail connectivity helper (forces IPv4 DNS preference in Node)
NODE_OPTIONS=--dns-result-order=ipv4first

FRONTEND_URL=http://localhost:3000

REACT_APP_API_URL=http://localhost:9000
