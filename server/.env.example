PORT=9000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultzero
PG_FORCE_SSL=false

JWT_SECRET=
HMAC_SECRET=

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional: custom SMTP provider configuration (if not using Gmail service defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Render/Gmail connectivity helper (forces IPv4 DNS preference in Node)
NODE_OPTIONS=--dns-result-order=ipv4first

FRONTEND_URL=http://localhost:3000

REACT_APP_API_URL=http://localhost:9000
